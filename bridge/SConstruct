#!/usr/bin/env python
# Build: scons platform=linux target=template_release   (from bridge/)
#        scons platform=windows target=template_release use_mingw=yes
# Output goes to game/bin/, referenced by game/bin/aimbridge.gdextension.
import os

env = SConscript("godot-cpp/SConstruct", {"api_version": "4.7"})

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

if env["platform"] == "linux":
    env.Append(LIBS=["rt", "pthread"])

library = env.SharedLibrary(
    "../game/bin/libaimbridge{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

env.NoCache(library)
Default(library)
