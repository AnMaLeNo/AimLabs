[configuration]

entry_symbol = "aimbridge_library_init"
compatibility_minimum = "4.7"

[libraries]

linux.debug.x86_64 = "res://bin/libaimbridge.linux.template_release.x86_64.so"
linux.release.x86_64 = "res://bin/libaimbridge.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libaimbridge.windows.template_release.x86_64.dll"
windows.release.x86_64 = "res://bin/libaimbridge.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libaimbridge.macos.template_release.universal.dylib"
macos.release = "res://bin/libaimbridge.macos.template_release.universal.dylib"
